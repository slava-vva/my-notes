@model MyNotes.Models.Note
@{
    ViewData["Title"] = "Edit note";
}

<div class="row justify-content-center">
    <div class="col-xl-9">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="d-flex flex-wrap justify-content-between align-items-baseline gap-2 mb-3">
                    <h4 class="card-title mb-0">Edit note</h4>
                    <small class="text-body-secondary">
                        Created @Model.CreatedDate.ToString("dd-MM-yyyy HH:mm")
                        &middot; Updated @Model.UpdatedDate.ToString("dd-MM-yyyy HH:mm")
                    </small>
                </div>

                <form asp-action="Edit" method="post" class="js-ctrl-enter" autocomplete="off">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" asp-for="Id" />

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control" rows="14"></textarea>
                    </div>
                    <div class="mb-3">
                        <label asp-for="links" class="form-label"></label>
                        <textarea asp-for="links" class="form-control" rows="4" placeholder="One link per line"></textarea>
                    </div>
                    <div class="mb-4">
                        <label asp-for="Tags" class="form-label"></label>
                        <input asp-for="Tags" class="form-control" placeholder="comma, separated, tags" />
                    </div>

                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <button type="submit" class="btn btn-primary">Save</button>
                        <a class="btn btn-outline-secondary" asp-action="List">Cancel</a>
                        <small class="text-body-secondary ms-1">Ctrl+Enter to save</small>
                        <a class="btn btn-outline-danger ms-auto" asp-action="Delete" asp-route-id="@Model.Id">Delete</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
