@model MyNotes.Models.NotesModel
@{
    ViewData["Title"] = "Notes";
    var nameError = ViewData.ModelState["Name"]?.Errors.FirstOrDefault()?.ErrorMessage;
}

<div class="row g-4">
    <!-- New note -->
    <div class="col-lg-4">
        <div class="card shadow-sm notes-sticky">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-baseline mb-3">
                    <h4 class="card-title mb-0">New note</h4>
                    <small class="text-body-secondary">@DateTime.Now.ToString("dd-MM-yyyy HH:mm")</small>
                </div>
                <form asp-action="Create" method="post" id="createForm" class="js-ctrl-enter" autocomplete="off">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="mb-3">
                        <label asp-for="InputNote.Name" class="form-label"></label>
                        <input asp-for="InputNote.Name" name="Name" class="form-control @(nameError != null ? "is-invalid" : "")" placeholder="What is this note about?" />
                        @if (nameError != null)
                        {
                            <div class="invalid-feedback">@nameError</div>
                        }
                    </div>
                    <div class="mb-3">
                        <label asp-for="InputNote.Description" class="form-label"></label>
                        <textarea asp-for="InputNote.Description" name="Description" class="form-control my-text-desription" rows="6"></textarea>
                    </div>
                    <div class="mb-3">
                        <label asp-for="InputNote.links" class="form-label"></label>
                        <textarea asp-for="InputNote.links" name="links" class="form-control my-text-links" rows="3" placeholder="One link per line"></textarea>
                    </div>
                    <div class="mb-3">
                        <label asp-for="InputNote.Tags" class="form-label"></label>
                        <input asp-for="InputNote.Tags" name="Tags" class="form-control" placeholder="comma, separated, tags" />
                        <div class="form-text">Suggested from the topic until you type your own.</div>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <button type="submit" class="btn btn-primary">Create</button>
                        <small class="text-body-secondary">or Ctrl+Enter</small>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Search + results -->
    <div class="col-lg-8">
        <form asp-action="Search" method="post" id="searchForm" class="mb-3" autocomplete="off">
            <div class="input-group">
                <span class="input-group-text" aria-hidden="true">&#128269;</span>
                <input asp-for="SearchTerm" id="searchInput" class="form-control" placeholder="Search topics, text, links and tags... (Esc to clear)" />
                <button type="button" class="btn btn-outline-secondary" id="clearSearch" title="Clear search">&times;</button>
            </div>
        </form>
        <div id="searchResults" aria-live="polite">
            <partial name="_SearchResults" model="Model" />
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        (function () {
            // ---- Live search: waits until you pause typing and ignores out-of-date responses ----
            const form = document.getElementById('searchForm');
            const input = document.getElementById('searchInput');
            const clear = document.getElementById('clearSearch');
            const results = document.getElementById('searchResults');
            let timer = null;
            let controller = null;
            let searchVersion = 0;   // bumps on every new search so a late "Show more" can't append to new results

            function runSearch() {
                clearTimeout(timer);
                searchVersion++;
                if (controller) controller.abort();
                const current = new AbortController();
                controller = current;
                results.classList.add('is-loading');

                fetch(form.action, { method: 'POST', body: new FormData(form), signal: current.signal })
                    .then(response => {
                        if (!response.ok) throw new Error('HTTP ' + response.status);
                        return response.text();
                    })
                    .then(html => { results.innerHTML = html; })
                    .catch(error => {
                        if (error.name !== 'AbortError') console.error('Search failed:', error);
                    })
                    .finally(() => {
                        if (controller === current) results.classList.remove('is-loading');
                    });
            }

            input.addEventListener('input', () => {
                clearTimeout(timer);
                timer = setTimeout(runSearch, 250);
            });

            input.addEventListener('keydown', e => {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    runSearch();
                } else if (e.key === 'Escape') {
                    input.value = '';
                    runSearch();
                }
            });

            form.addEventListener('submit', e => { e.preventDefault(); runSearch(); });

            clear.addEventListener('click', () => {
                input.value = '';
                runSearch();
                input.focus();
            });

            // "Show more": load the next 20 notes for the same search and append them
            function loadMore(button) {
                const version = searchVersion;
                const wrap = button.closest('.js-show-more-wrap');
                const label = button.textContent;
                button.disabled = true;
                button.textContent = 'Loading...';

                const data = new FormData(form);
                data.set('SearchTerm', button.dataset.term || '');
                data.set('skip', button.dataset.skip);

                fetch(form.action, { method: 'POST', body: data })
                    .then(response => {
                        if (!response.ok) throw new Error('HTTP ' + response.status);
                        return response.text();
                    })
                    .then(html => {
                        if (version !== searchVersion) return;   // a newer search replaced the list
                        wrap.insertAdjacentHTML('afterend', html);
                        wrap.remove();
                    })
                    .catch(error => {
                        console.error('Show more failed:', error);
                        button.disabled = false;
                        button.textContent = label;
                    });
            }

            results.addEventListener('click', e => {
                const more = e.target.closest('.js-show-more');
                if (more) {
                    e.preventDefault();
                    loadMore(more);
                    return;
                }

                // Clicking a tag searches for it
                const tag = e.target.closest('[data-tag]');
                if (!tag) return;
                e.preventDefault();
                input.value = tag.dataset.tag;
                runSearch();
                window.scrollTo({ top: 0, behavior: 'smooth' });
            });

            // ---- Tag suggestions from the topic, until you edit the tags yourself ----
            const nameInput = document.getElementById('InputNote_Name');
            const tagsInput = document.getElementById('InputNote_Tags');
            let tagsTouched = tagsInput.value.trim() !== '';

            tagsInput.addEventListener('input', () => {
                tagsTouched = tagsInput.value.trim() !== '';
            });

            nameInput.addEventListener('input', () => {
                if (tagsTouched) return;
                const topic = nameInput.value.trim().toLowerCase();
                let tags;
                if (topic.includes('asp.net')) {
                    tags = 'asp.net, razor, mvc';
                } else if (topic.includes('react')) {
                    tags = 'react, javascript, frontend';
                } else if (topic.includes('django')) {
                    tags = 'django, python, backend';
                } else {
                    tags = topic.split(/\s+/).filter(Boolean).join(', ');
                }
                tagsInput.value = tags;
            });

            // Focus: the topic field if it has an error, otherwise the search box
            if (nameInput.classList.contains('is-invalid')) {
                nameInput.focus();
            } else {
                input.focus();
            }
        })();
    </script>
}
